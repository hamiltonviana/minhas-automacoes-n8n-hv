      "parameters": {
        "jsCode": "const g = $json;\nconst NL = String.fromCharCode(10);\nconst d = String(g.agora_brt || '').slice(0, 10).split('-').reverse().slice(0, 2).join('/');\nconst n = (v) => Number(v || 0);\nlet t = '📊 Resumo da prospecção — ' + d + NL + NL;\nt += 'Enviados hoje: ' + n(g.enviados_hoje) + NL;\nt += 'Respostas de leads (não robô): ' + n(g.respostas_hoje) + NL;\nt += 'Robôs detectados e bloqueados: ' + n(g.robos_hoje) + NL;\nt += 'Sem WhatsApp: ' + n(g.sem_whatsapp_hoje) + NL;\nt += 'Erros de envio: ' + n(g.erros_envio_hoje) + NL;\nt += 'Fila restante: ' + n(g.fila_restante) + ' leads' + NL;\nt += 'Canal: ' + g.canal_status + NL;\nif (n(g.respostas_hoje) > 0) t += NL + '👉 Há resposta de lead esperando você no CRM (Prospecção Fria).';\nif (g.canal_status !== 'WORKING' || n(g.erros_envio_hoje) >= 2) t += NL + '⚠️ Atenção: confira o canal antes do próximo dia.';\nif (n(g.fila_restante) < 15) t += NL + '📌 Fila baixando: hora de rodar o WF00 e captar mais leads.';\nreturn [{ json: { texto: t } }];"
      }
    },
