    {
      "id": "4084b3e1-8452-416b-a2f6-8628f955addc",
      "name": "Transformar Resultado em Leads v4",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2192,
        736
      ],
      "parameters": {
        "jsCode": "function gerarUUID() {\n  return 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, function(c) {\n    const r = Math.floor(Math.random() * 16);\n    const v = c === 'x' ? r : (r & 0x3) | 0x8;\n    return v.toString(16);\n  });\n}\n\nconst places = items[0].json.places || [];\n\nconst parametros = $('Definir Parametros').item.json || {};\nconst nicho = parametros.nicho_padrao || '';\nconst cidade = parametros.cidade_padrao || '';\nconst termoEspecifico = parametros.termo_especifico || '';\nconst query = parametros.query || '';\n\nreturn places\n  .map(place => {\n    if (!place.id) return null;\n\n    const idGerado = gerarUUID();\n    const nome = place.displayName?.text || '';\n    const placeId = place.id;\n\n    return {\n      json: {\n        id: idGerado,\n        id_interno: idGerado,\n        nome,\n        negocio: nome,\n        interesse: `${nicho} | ${cidade}`,\n        nicho,\n        cidade,\n        termo_especifico: termoEspecifico,\n        query_busca: query,\n        place_id: placeId,\n        google_place_id: placeId,\n        google_maps_url: `https://www.google.com/maps/place/?q=place_id:${placeId}`,\n        telefone: '',\n        telefone_normalizado: '',\n        instagram: '',\n        origem: 'google_maps',\n        mensagem_inicial: '',\n        status: 'pronto_para_contato',\n        etapa: 'captado',\n        score: '',\n        observacoes: place.formattedAddress || '',\n        data_criacao: new Date().toISOString(),\n        tipo_registro: 'novo'\n      }\n    };\n  })\n  .filter(Boolean);"
      }
    },
    {
      "id": "33c3c24e-987b-43ca-b98c-66b595a0dd40",
