        "jsCode": "const ORG_ID = '<ORGANIZATION_ID>';\nconst PIPELINE_ID = '478acf1c-3d77-4a96-af80-4a7a6209cd17';\nconst STAGE_CAPTADO = '75723cca-7cd5-41ee-a911-9dbd1972a861';\n\nconst _todos = items.map((item, idx) => ({ item, idx })).filter(({ item }) => item.json && item.json.id);\nreturn _todos.map(({ item, idx }) => {\n  const contact = item.json;\n  const original = $('Preparar Dados Empresa').all()[idx].json;\n\n  const meta = {};\n  if (original.place_id) meta.place_id = original.place_id;\n  if (original.nicho) meta.nicho = original.nicho;\n  if (original.query_busca) meta.query_busca = original.query_busca;\n\n  const body = {\n    organization_id: ORG_ID,\n    pipeline_id: PIPELINE_ID,\n    stage_id: STAGE_CAPTADO,\n    contact_id: contact.id,\n    title: original.nome || contact.name || '',\n    source: 'prospeccao_gmn',\n    source_metadata: meta,\n    status: 'open'\n  };\n  return { json: { ...original, _lead_body: JSON.stringify(body) } };\n});"
