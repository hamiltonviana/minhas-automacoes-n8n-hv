    {
      "id": "37a91cf6-64f1-41bb-bfd1-957dc7f0975b",
      "name": "Restaurar ID Interno",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2864,
        736
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const j = $json || {};\n\nconst idInterno = j.id_interno || '';\nconst placeId = j.place_id || j.google_place_id || j.id || '';\n\nreturn {\n  json: {\n    ...j,\n    id: idInterno,\n    id_interno: idInterno,\n    place_id: placeId,\n    google_place_id: placeId,\n    google_place_id_details: j.id,\n    google_maps_url:\n      j.google_maps_url ||\n      (placeId ? `https://www.google.com/maps/place/?q=place_id:${placeId}` : '')\n  }\n};"
      }
    },
    {
      "id": "6a7645a9-adc2-46fc-8444-02476a3ea129",
      "name": "Enriquecer com Telefone",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3088,
        736
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const details = $json || {};\nconst telIntl = details.internationalPhoneNumber || '';\nconst telLocal = details.nationalPhoneNumber || '';\nconst telefone = telIntl || telLocal;\nconst telefoneNormalizado = String(telefone || '').replace(/\\D/g, '');\n\nconst avaliacoes = (details.userRatingCount !== undefined && details.userRatingCount !== null)\n  ? Number(details.userRatingCount)\n  : 0;\n\nconst nota = (details.rating !== undefined && details.rating !== null)\n  ? Number(details.rating)\n  : '';\n\n// horario de funcionamento do GMN, no mesmo formato que o WF01 le em contacts.source_metadata.horario_gmn\nconst roh = details.regularOpeningHours || null;\nconst horarioGmn = (roh && Array.isArray(roh.periods) && roh.periods.length)\n  ? { periods: roh.periods, descricao: roh.weekdayDescriptions || [], utc_offset_min: details.utcOffsetMinutes ?? null, fonte: 'places_v1', buscado_em: new Date().toISOString() }\n  : null;\n\nreturn {\n  json: {\n    ...$json,\n    telefone,\n    telefone_normalizado: telefoneNormalizado,\n    observacoes: details.formattedAddress || $json.observacoes || '',\n    AVALIACOES_GMN: avaliacoes,\n    NOTA_GMN: nota,\n    horario_gmn: horarioGmn\n  }\n};"
      }
    },
    {
      "id": "buscar-instagram-wf00",
      "name": "Buscar Instagram Google",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "continueOnFail": true,
      "position": [
        3312,
        736
      ],
      "parameters": {
        "url": "=https://www.google.com/search?q={{ encodeURIComponent($json.nome + ' ' + ($json.cidade || '') + ' instagram') }}",
        "sendHeaders": true,
        "specifyHeaders": "json",
        "jsonHeaders": "{\"User-Agent\":\"Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36\",\"Accept-Language\":\"pt-BR,pt;q=0.9\",\"Accept\":\"text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8\"}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "text"
            }
          },
          "timeout": 12000
        }
      }
    },
    {
      "id": "extrair-instagram-wf00",
      "name": "Extrair Instagram",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3536,
        736
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const html = String($json.body || $json.data || '');\nconst lead = $('Enriquecer com Telefone').item.json;\n\nconst blacklist = ['p','reel','stories','explore','accounts','legal','help','about','press','api','privacy','terms','sharedfiles','reels','highlights','tv'];\n\nconst regex = /(?:https?:\\/\\/)?(?:www\\.)?instagram\\.com\\/([A-Za-z0-9._]{3,30})(?:\\/|\\?|\\\"|'|\\\\u0026|&|\\s|$)/gi;\nconst found = [];\nlet match;\nwhile ((match = regex.exec(html)) !== null) {\n  const username = match[1].toLowerCase();\n  if (!blacklist.includes(username)) {\n    found.push('https://www.instagram.com/' + match[1]);\n  }\n}\n\nconst unique = [...new Set(found)];\nconst instagramUrl = unique[0] || 'Perfil_não_encontrado';\n\nreturn { json: { ...lead, instagram: instagramUrl } };"
      }
    },
