    {
      "id": "a2b3c4d5-e6f7-8901-bcde-f01234567890",
      "name": "Preparar Dados Empresa",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        4656,
        832
      ],
      "parameters": {
        "jsCode": "const ORG_ID = '<ORGANIZATION_ID>';\nreturn items.map(item => {\n  const j = item.json;\n  const meta = { origem: 'google_maps' };\n  if (j.place_id) meta.place_id = j.place_id;\n  if (j.google_maps_url) meta.google_maps_url = j.google_maps_url;\n  if (j.AVALIACOES_GMN) meta.avaliacoes_gmn = Number(j.AVALIACOES_GMN);\n  if (j.NOTA_GMN !== '' && j.NOTA_GMN !== null && j.NOTA_GMN !== undefined) meta.nota_gmn = Number(j.NOTA_GMN);\n  if (j.cidade) meta.cidade = j.cidade;\n  if (j.nicho) meta.nicho = j.nicho;\n  if (j.instagram && j.instagram !== 'Perfil_não_encontrado') meta.instagram = j.instagram;\n  // horario do GMN: o WF01 usa para so disparar com a loja aberta (pizzaria/hamburgueria fecham de dia)\n  if (j.horario_gmn && Array.isArray(j.horario_gmn.periods) && j.horario_gmn.periods.length) meta.horario_gmn = j.horario_gmn;\n\n  const body = {\n    organization_id: ORG_ID,\n    name: j.nome || '',\n    phone_number: j.telefone_normalizado ? ('+' + j.telefone_normalizado) : null,\n    source: 'prospeccao_gmn',\n    source_metadata: meta,\n    tags: j.nicho ? [j.nicho] : []\n  };\n  return { json: { ...j, _body: JSON.stringify(body) } };\n});"
      }
    },
