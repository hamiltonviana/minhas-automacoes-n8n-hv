      ],
      "parameters": {
        "jsCode": "const all = $input.all();\nconst params = $('Definir Parametros').first().json;\nconst forcar = params.forcar_nova_busca === true;\nconst firstJson = all.length > 0 ? all[0].json : {};\nconst jaExiste = !!(firstJson && firstJson.id);\nconst podeProsseguir = !jaExiste || forcar;\n\nreturn [{\n  json: {\n    ...params,\n    ja_prospectado: jaExiste,\n    pode_prosseguir: podeProsseguir,\n    prospecao_anterior: jaExiste ? firstJson : null\n  }\n}];"
