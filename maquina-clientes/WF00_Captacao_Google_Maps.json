    {
      "id": "2864b73a-9535-46ea-ac88-a2a739d5415b",
      "name": "Classificador Blindado",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        4208,
        832
      ],
      "parameters": {
        "jsCode": "const existentes = items.filter(i => i.json.tipo_registro === 'existente');\nconst novos = items.filter(i => i.json.tipo_registro === 'novo');\n\nconst idsExistentes = new Set(\n  existentes\n    .map(i => i.json.place_id)\n    .filter(Boolean)\n);\n\nreturn novos.filter(item => {\n  const j = item.json;\n  if (!j.place_id) return false;\n  if (idsExistentes.has(j.place_id)) return false;\n  return true;\n});"
      }
    },
    {
